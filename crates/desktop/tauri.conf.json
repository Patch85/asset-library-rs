{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Library",
  "version": "0.1.0",
  "identifier": "com.assetlibrary.desktop",
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A local, searchable, taggable library for TTRPG assets",
    "longDescription": "Index your token and map folders in place, then search, tag and export them. Optional local AI search runs on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/onnxruntime/lib/*": "onnxruntime/"
    }
  }
}
